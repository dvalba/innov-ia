# Innov-IA backend — sample configuration. Copy it to `backend/.env` (never
# commit the real `.env`): `cp .env.example .env`
# Precedence: real environment variables > backend/.env > built-in defaults.
# All variables are optional; defaults let the backend start without a file.

# Ollama: base URL of the service (any host of the LAN works) and the model
# that must already be pulled (`ollama list`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT=60

# Directory with the JSON stores (relative to the backend root or absolute).
INNOV_DATA_DIR=data

# First administrator, seeded once at first startup (skip to disable the seed).
INNOV_ADMIN_USERNAME=admin
INNOV_ADMIN_PASSWORD=

# Comma-separated list of allowed origins (needed for dev with `ng serve`).
CORS_ORIGINS=http://localhost:4200
